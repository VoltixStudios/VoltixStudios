// Voltix Analytics — the summaries. A Worker with no schedule and no
// address: workers_dev is off and there is no route, so nothing can call it.
//
//   npx wrangler deploy            from this folder, once the database exists
//
// database_id: the id of the D1 database "va" (Cloudflare → Storage & Databases
// → D1 → va, or `npx wrangler d1 list`), created by Sr. Orra on 30 October
// 2026. It is not a secret; it is useless without the account.
{
  "name": "va-nightly",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // No schedule (Sr. Orra, 18 November 2026): the summaries are rebuilt only when the
  // dashboard's Refresh now button asks. Until then they ran at 08:00 and 22:00 in Spain
  // ("0 7 * * *" and "0 21 * * *" in winter). An empty list removes the triggers on deploy.
  "triggers": { "crons": [] },
  "d1_databases": [
    { "binding": "VA", "database_name": "va", "database_id": "911df83d-68ab-45f0-b5d2-6f0d92a55592" }
  ]
}
